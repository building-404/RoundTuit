root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = false

[*.json]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.yaml]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.py]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
